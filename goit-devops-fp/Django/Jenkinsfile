pipeline {
    agent {
        kubernetes {
            defaultContainer 'docker'
            jenkinsUrl 'http://jenkins.jenkins.svc.cluster.local:8080'
            jenkinsTunnel 'jenkins-agent.jenkins.svc.cluster.local:50000'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins
spec:
  serviceAccountName: jenkins
  securityContext:
    runAsUser: 0
    fsGroup: 0
  containers:
  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    command:
    - cat
    tty: true
'''
        }
    }

    environment {
        registry = "${ECR_REPOSITORY_URL}" // This variable should be set in Jenkins
        registryCredential = 'ecr-credentials' // Jenkins credential ID
        dockerImage = ''
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Building image') {
            steps {
                container('docker') {
                    script {
                        // Start Docker daemon in background
                        sh 'nohup dockerd > /tmp/dockerd.log 2>&1 &'
                        sh 'sleep 10'
                        
                        dockerImage = docker.build(registry + ":$BUILD_NUMBER", "./Django")
                    }
                }
            }
        }

        stage('Pushing to ECR') {
            steps {
                container('docker') {
                    script {
                        docker.withRegistry('https://' + registry.split('/')[0], "ecr:eu-central-1:" + registryCredential) {
                            dockerImage.push()
                            dockerImage.push('latest')
                        }
                    }
                }
            }
        }
    }
}
